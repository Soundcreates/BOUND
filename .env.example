# Rabdi public test network (not a private key)
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
ARKIV_SCHEMA_TAG=bound.record.v1
ARKIV_ENTITY_TTL_BLOCKS=
ARKIV_TEST_WRITER_ADDRESS=

# Secrets stay only in the ignored local .env file; leave blank until secure setup.
ARKIV_TEST_WRITER_PRIVATE_KEY=
ARKIV_ACCESS_KEY=

# Controlled DNS/TLS host is optional for local tests. Host only; no scheme.
BOUND_TEST_HOST=
BOUND_TEST_NS_ZONE=
BOUND_TEST_SERVER_IP=
BOUND_TEST_SECONDARY_SERVER_IP=
BOUND_DNS_PROVIDER=
BOUND_HTTPS_HOSTING_PROVIDER=

# Public addresses for the local-only fictional demo app on chain 31337.
BOUND_DEMO_TOKEN=
BOUND_DEMO_SPENDER=
BOUND_DEMO_PORT=4173
