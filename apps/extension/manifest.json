{
  "manifest_version": 3,
  "name": "BOUND",
  "version": "0.1.0",
  "description": "Phase 0 wallet request interception prototype.",
  "minimum_chrome_version": "119",
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "permissions": ["storage", "tabs", "offscreen", "alarms", "webNavigation", "notifications", "debugger", "scripting"],
  "action": {
    "default_title": "BOUND coverage",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://*/*"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "sandbox": { "pages": ["anon-rpc/*/sandbox.html"] },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; child-src 'self' blob:; worker-src 'self' blob:; connect-src *;"
  }
}
